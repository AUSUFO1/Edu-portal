{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uemp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "uemp" }],
  "hyperdrive": [
    {
      // Pooled connection to the Neon Postgres database. Create it with:
      //   npx wrangler hyperdrive create uemp-db --connection-string="<Neon connection string>"
      // then paste the returned id here.
      "binding": "HYPERDRIVE",
      "id": "690cb52bdbeb42cc9b61d1666bce980a"
    }
  ],
  "observability": { "enabled": true }
}
